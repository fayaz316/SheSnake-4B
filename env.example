# Copy this file to .env.local and run:
#   set -a; source .env.local; set +a
# The primary local track needs no paid API key. Never commit .env.local.

HF_TOKEN="OPTIONAL_HUGGING_FACE_TOKEN_FOR_UPLOAD"
HF_USERNAME="YOUR_HUGGING_FACE_USERNAME"
HF_MODEL_REPO="YOUR_HUGGING_FACE_USERNAME/shesnake-4b"

# Local MLX checkpoints. Downloads are cached under models/ and ignored by Git.
BASE_MODEL_ID="mlx-community/Qwen3-4B-Instruct-2507-4bit"
BASE_MODEL_PATH="models/qwen3-4b-instruct-2507-4bit"
MISTRAL_MODEL_ID="mlx-community/Ministral-3-3B-Instruct-2512-4bit"
MISTRAL_MODEL_PATH="models/ministral-3-3b-instruct-2512-4bit"
ADAPTER_PATH="finetune/adapters/shesnake-4b"
